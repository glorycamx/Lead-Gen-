# Massachusetts Solar + Mass Save Lead Bot
# Environment Variables
# =====================

# Database
DATABASE_URL="file:./data/leads.db"

# Server Configuration
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# AI Provider (Optional - system works without these)
# --------------------------------------------------
# OpenAI (for AI-generated notes)
# OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic (alternative AI provider)
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Geocoding (Optional - for radius-based targeting)
# ------------------------------------------------
# OpenCage Geocoder (free tier available)
# OPENCAGE_API_KEY=your-opencage-key-here

# Google Maps Geocoding
# GOOGLE_MAPS_API_KEY=your-google-maps-key-here

# Google Sheets Integration (Optional)
# -----------------------------------
# GOOGLE_SHEETS_ENABLED=false
# GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id
# GOOGLE_SHEETS_CREDENTIALS_PATH=./credentials/google-service-account.json

# Logging
LOG_LEVEL=info

# Security
# --------
# Session secret for dashboard (generate a random string)
SESSION_SECRET=change-this-to-a-random-string-in-production

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
